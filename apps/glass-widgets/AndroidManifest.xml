<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.bilal.glass" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
    <application android:label="@string/app_name" android:icon="@drawable/preview_now" android:allowBackup="false">
        <receiver android:name=".ClockCard" android:exported="true" android:label="@string/clock_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="dev.bilal.glass.TICK"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/><action android:name="android.intent.action.TIME_SET"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_info"/>
        </receiver>
        <receiver android:name=".NowPlayingCard" android:exported="true" android:label="@string/now_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/now_info"/>
        </receiver>
        <receiver android:name=".PinReceiver" android:exported="true"/>
        <service android:name=".MediaListener" android:exported="true" android:label="@string/now_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
        </service>
    </application>
</manifest>
